# Supabase Postgres — use the pooled/pgbouncer connection string (port 6543),
# not the direct one, since Vercel functions are serverless.
DATABASE_URL=postgresql://postgres:[password]@[project].pooler.supabase.com:6543/postgres

# JWT signing secret for staff auth (min 16 chars). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-min-16-chars

# AES-256-GCM key used to encrypt RNDC credentials at rest — 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
CREDENTIALS_ENC_KEY=

PORT=4000
NODE_ENV=development
